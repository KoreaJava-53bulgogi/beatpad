rules_version = '2';

// BEAT PAD Firestore 보안 규칙 (Google 로그인 버전)
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여 넣고 "게시"하세요.
//
// - users/{uid}: 본인만 읽고 쓸 수 있다 (닉네임, 설정, 내 최고 기록).
// - leaderboards/{board}/scores/{uid}: 누구나 볼 수 있다.
//   로그인한 본인만 자기 uid 칸에 쓸 수 있고, 기존보다 높은 점수로만 바꿀 수 있다.
//   랭킹에 보이는 이름은 내 계정의 닉네임과 같아야 한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function myNickname() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname;
    }

    function isValidScore(d) {
      return d.keys().hasOnly(['name', 'score', 'acc', 'rank', 'fc', 'maxCombo', 'song', 'diff', 'long', 'updatedAt'])
        && d.keys().hasAll(['name', 'score', 'acc', 'rank', 'fc', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.name == myNickname()
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.acc is number && d.acc >= 0 && d.acc <= 100
        && d.rank in ['S', 'A', 'B', 'C', 'D']
        && d.fc is bool
        && (!('maxCombo' in d) || (d.maxCombo is int && d.maxCombo >= 0 && d.maxCombo <= 100000))
        && (!('song' in d) || (d.song is string && d.song.size() <= 80))
        && (!('diff' in d) || d.diff in ['EASY', 'NORMAL', 'HARD'])
        && (!('long' in d) || d.long is bool)
        && d.updatedAt == request.time;
    }

    function isValidProfile(d) {
      return d.keys().hasOnly(['nickname', 'settings', 'best', 'updatedAt'])
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 12
        && (!('settings' in d) || d.settings is map)
        && (!('best' in d) || d.best is map)
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if false;
    }

    match /leaderboards/{board}/scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && isValidScore(request.resource.data);
      allow update: if isOwner(uid) && isValidScore(request.resource.data)
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
